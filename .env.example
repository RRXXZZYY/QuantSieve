# Backend
# Required in production; inject the immutable commit or release identifier.
QUANTSIEVE_BUILD_VERSION=0.1.0
# Optional until the build pipeline injects them. Runs remain usable but are
# honestly marked incomplete when either immutable provenance value is absent.
# QUANTSIEVE_SOURCE_REVISION=0123456789abcdef0123456789abcdef01234567
# QUANTSIEVE_DEPENDENCY_LOCK_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
QUANTSIEVE_DATABASE_PATH=./data/quantsieve.db
QUANTSIEVE_CACHE_PATH=./data/cache.db
# Factor research has a request gate, a separate provider-work gate that remains
# leased while non-cancellable blocking calls finish, and one end-to-end deadline.
QUANTSIEVE_FACTOR_RESEARCH_MAX_CONCURRENCY=1
QUANTSIEVE_FACTOR_RESEARCH_PROVIDER_MAX_CONCURRENCY=8
QUANTSIEVE_FACTOR_RESEARCH_DEADLINE_SECONDS=45
QUANTSIEVE_SEC_USER_AGENT=QuantSieve local-user contact@example.com
QUANTSIEVE_CORS_ORIGINS=http://localhost:3000

# Optional BYOK defaults. Keys can also be supplied per request and are never persisted.
QUANTSIEVE_LLM_BASE_URL=https://api.openai.com/v1
QUANTSIEVE_LLM_MODEL=gpt-4.1-mini
# QUANTSIEVE_LLM_API_KEY=

# Official X API. Without this token, the UI explicitly reports that direct X posts
# are disconnected and does not substitute related-asset prices for a person's post.
# QUANTSIEVE_X_BEARER_TOKEN=
QUANTSIEVE_X_API_BASE_URL=https://api.x.com/2

# Optional private English-to-Chinese news translation. Keep disabled unless an
# internal LibreTranslate/Argos sidecar is reachable from the API container.
# Translation is requested on demand, cached separately, and never overwrites
# the stored source text.
QUANTSIEVE_TRANSLATION_ENABLED=false
QUANTSIEVE_TRANSLATION_BASE_URL=http://translate:5000
QUANTSIEVE_TRANSLATION_TIMEOUT_SECONDS=45
QUANTSIEVE_TRANSLATION_BATCH_LIMIT=18
QUANTSIEVE_TRANSLATION_CACHE_TTL_DAYS=90
QUANTSIEVE_TRANSLATION_CONTRACT_VERSION=argos-en-zh-v1

# Production polling for X and geopolitical sources. Keep disabled for local tests.
QUANTSIEVE_MONITOR_SCHEDULER_ENABLED=false
QUANTSIEVE_MONITOR_POLL_SECONDS=60

# Legacy single-instrument paper tracking. It only models historical/new market bars;
# it never connects an exchange or brokerage account and never submits orders.
QUANTSIEVE_PAPER_SCHEDULER_ENABLED=true
QUANTSIEVE_PAPER_POLL_SECONDS=60

# Internal-only Binance Spot one-session portfolio observation. Both schedulers are
# disabled by default. Enable them only after the NAS clock, network isolation, and
# finalized-bar evidence path have been verified. They model an opening observation
# and a later close valuation; neither setting enables real trading or account access.
QUANTSIEVE_PORTFOLIO_OPENING_SCHEDULER_ENABLED=false
QUANTSIEVE_PORTFOLIO_OPENING_POLL_SECONDS=5
QUANTSIEVE_PORTFOLIO_OPENING_QUOTE_DEADLINE_SECONDS=4
QUANTSIEVE_PORTFOLIO_OPENING_LEASE_SECONDS=15
QUANTSIEVE_PORTFOLIO_SETTLEMENT_SCHEDULER_ENABLED=false
QUANTSIEVE_PORTFOLIO_SETTLEMENT_POLL_SECONDS=60
QUANTSIEVE_PORTFOLIO_SETTLEMENT_HISTORY_DEADLINE_SECONDS=20
QUANTSIEVE_PORTFOLIO_SETTLEMENT_LEASE_SECONDS=30

# Next.js server-side proxy target. Docker uses http://api:8000 by default.
QUANTSIEVE_API_INTERNAL_URL=http://localhost:8000

# Optional browser-visible override. Leave unset to use the same-origin /backend proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000
